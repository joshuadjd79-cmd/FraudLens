# ==============================================================================
# FraudLens Environment Configuration Template
# Copy this file to .env and configure your environment specifics.
# Do NOT commit production credentials to source control.
# ==============================================================================

# Application Settings
APP_NAME="FraudLens Financial Fraud Detection Platform"
APP_VERSION="1.0.0"
DEBUG=False

# API Server Configuration
API_HOST="127.0.0.1"
API_PORT=8000
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Oracle Database Connection (FreePDB1 on Oracle AI 26ai Free / 23ai / 19c)
# Thin mode connects directly using TCP without requiring Oracle Instant Client!
ORACLE_USER="FRAUDLENS_USER"
ORACLE_PASSWORD="YOUR_ORACLE_PASSWORD_HERE"
ORACLE_HOST="localhost"
ORACLE_PORT=1521
ORACLE_SERVICE_NAME="freepdb1"
# Optional full DSN override:
# ORACLE_DSN="localhost:1521/freepdb1"

# Oracle Connection Pooling
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10
ORACLE_POOL_INCREMENT=1

# Business Rules Engine Configuration
HIGH_AMOUNT_THRESHOLD=50000.0

# Set to True if testing frontend without an active Oracle database
DEMO_MODE=False
